{
  "permissions": {
    "allow": [
      "Bash(changelog-lint:*)",
      "Bash(dhall-to-yaml-ng:*)",
      "Bash(dhall:*)",
      "Bash(hlint:*)",
      "Bash(nix run '.#generate-hlint')",
      "Bash(timeout 600 nix flake check:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && nix fmt"
          },
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && git ls-files -z *.cabal|parallel --verbose --null cabal-gild --io {}"
          }
        ]
      }
    ]
  }
}
