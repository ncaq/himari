{
  "permissions": {
    "allow": [
      "Bash(changelog-lint -config .changelog-lint.toml:*)",
      "Bash(dhall-to-yaml-ng:*)",
      "Bash(dhall:*)",
      "Bash(hlint:*)",
      "Bash(nix derivation show:*)",
      "Bash(nix flake check:*)",
      "Bash(nix run '.#generate-hlint')"
    ],
    "additionalDirectories": [
      "~/Desktop/aeson",
      "~/Desktop/bytestring",
      "~/Desktop/containers",
      "~/Desktop/convertible",
      "~/Desktop/ghc",
      "~/Desktop/haskell-language-server",
      "~/Desktop/haskell.nix",
      "~/Desktop/hlint",
      "~/Desktop/lens",
      "~/Desktop/mtl",
      "~/Desktop/pretty-simple",
      "~/Desktop/rio",
      "~/Desktop/safe",
      "~/Desktop/text",
      "~/Desktop/time",
      "~/Desktop/typed-process",
      "~/Desktop/unliftio",
      "~/Desktop/unordered-containers",
      "~/Desktop/vector"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && nix fmt"
          },
          {
            "type": "command",
            "command": "cd $CLAUDE_PROJECT_DIR && git ls-files -z *.cabal|parallel --verbose --null cabal-gild --io {}"
          }
        ]
      }
    ]
  }
}
