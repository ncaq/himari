cabal-version: 3.0
name: himari
version: 0.1.0.0
synopsis: A standard library for Haskell as an alternative to rio
homepage: https://github.com/ncaq/himari
license: Apache-2.0
license-file: LICENSE
author: ncaq
maintainer: ncaq@ncaq.net
category: Control
build-type: Simple
tested-with: ghc ==9.10.2

common basic
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -j

  default-language: GHC2024
  default-extensions:
    NoImplicitPrelude
    OverloadedStrings

  build-depends:
    base >=4.19.2.0 && <4.22,
    bytestring ^>=0.12.2.0,
    containers ^>=0.7,
    deepseq ^>=1.5.0.0,
    directory ^>=1.3.9.0,
    filepath ^>=1.5.4.0,
    hashable ^>=1.5.0.0,
    lens ^>=5.3.5,
    mtl ^>=2.3.1,
    primitive ^>=0.9.1.0,
    text ^>=2.1.2,
    time ^>=1.12.2,
    typed-process ^>=0.2.13.0,
    unliftio ^>=0.2.25.1,
    unordered-containers ^>=0.2.20,
    vector ^>=0.13.2.0,

library
  import: basic
  hs-source-dirs: src
  -- cabal-gild: discover ./src
  exposed-modules:
    Himari
    Himari.Prelude
